{
  "name": "the-pushup-challenge-2025",
  "private": true,
  "version": "1.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO_MODE=true vite",
    "build": "npm run lint && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "build:pages": "npm run build",
    "test:rules": "firebase emulators:exec --project demo-pushup-2027 --only auth,firestore \"node --test --test-concurrency=1 tests/emulator/*.test.js\"",
    "test:e2e": "playwright test",
    "test:integration": "firebase emulators:exec --project demo-pushup-2027 --only auth,firestore \"node --test --test-concurrency=1 tests/emulator/*.test.js && playwright test\"",
    "build:hosting": "VITE_BASE=/ VITE_ENABLE_V2_CLOUD=true vite build --outDir dist-hosting",
    "deploy:hosting": "npm run lint && npm test && npm run build:hosting && firebase deploy --only hosting --project pushup2025-df07b"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.35.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
